# App: the store's public address, without a trailing slash (metadata, sitemap, emails, links in
# the owner's notifications). Moving the store to its own domain is this one value, then a rebuild.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Uploads (images/videos) are stored on local disk and served at /uploads/...
# Production: point this outside the repo and serve it with nginx.
# UPLOAD_DIR=/var/www/kitvoy-uploads

# Database (Prisma + PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/store?schema=public"

# Admin authentication (the web dashboard's session and the mobile app's sign-in)
# SESSION_SECRET must be at least 32 characters
SESSION_SECRET=your-secure-random-string-at-least-32-chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-admin-password

# New-order email to the owner. Nothing is sent unless NOTIFY_EMAIL and the SMTP settings are all set.
NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true for port 465
SMTP_SECURE=false
# Optional "Name <address>"; defaults to SMTP_USER
SMTP_FROM=

# New-order push notifications to the admin app (FCM HTTP v1).
# base64 of the Firebase Admin SDK service-account JSON: base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Meta (Facebook/Instagram) ads. The pixel reports page views, add to cart, checkout and the order
# (as Purchase, in MAD); the Conversions API sends the same Purchase server-side with the same
# event_id. Nothing is sent server-side without the token.
# The pixel id is public; a production build falls back to the store's own (config/analytics.ts).
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
# Token: Events Manager → your pixel (dataset) → Settings → Conversions API → Generate access token
META_CAPI_ACCESS_TOKEN=
# Events Manager → Test events → the TESTxxxxx code; set only while testing, then remove it
META_TEST_EVENT_CODE=
# Graph API version for the Conversions API (default v26.0)
# META_GRAPH_API_VERSION=v26.0
