generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CUSTOMER
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  image        String?
  role         UserRole @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  reviews      Review[]
  orders       Order[]

  @@map("users")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  showInMenu  Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("categories")
}

model Product {
  id               String         @id @default(cuid())
  name             String
  slug             String         @unique
  shortDescription String
  description      String
  details          String
  price            Float
  shippingTax      Float          @default(0)
  compareAtPrice   Float?
  badge            String?
  rating           Float
  reviewCount      Int
  stock            Int
  sku              String
  isFeatured       Boolean        @default(false)
  categoryId       String
  category         Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  images           ProductImage[]
  reviews          Review[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  /// When what shoppers see last changed (name, copy, price, images). The sitemap's lastmod uses this; updatedAt also moves on every sale because stock changes
  contentUpdatedAt DateTime?

  @@index([categoryId])
  @@index([slug])
  @@index([isFeatured])
  @@map("products")
}

model Review {
  id          String    @id @default(cuid())
  /// Null for reviews written from the emailed review link of a guest order
  userId      String?
  productId   String
  /// The purchase this review is about; a paid order earns the "Verified Buyer" badge
  orderId     String?
  /// Name as written at submission (account or order name); shown as "First L."
  authorName  String?
  rating      Int
  comment     String
  images      String[]
  /// Approved for the storefront. New reviews wait for an admin to approve them.
  isVisible   Boolean   @default(false)
  moderatedAt DateTime?
  createdAt   DateTime  @default(now())
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  order       Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([userId, productId])
  @@unique([orderId, productId])
  @@index([productId])
  @@index([isVisible])
  @@map("reviews")
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String?
  order     Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELED
}

/// Manual fulfillment (Zendrop has no order API for custom stores)
enum FulfillmentStatus {
  UNFULFILLED
  SHIPPED
  DELIVERED
}

model Order {
  id                String            @id @default(cuid())
  customerName      String
  email             String?
  phone             String
  /// One-line address ("street, city, STATE ZIP") for admin, emails and packing slips
  location          String
  /// Structured US address { address1, address2, city, state, zip, country } for fulfillment
  shippingAddress   Json?
  status            OrderStatus       @default(PENDING)
  subtotal          Float
  shippingCost      Float
  total             Float
  currency          String            @default("USD")
  locale            String            @default("en")
  /// "card" (Stripe) | "paypal"
  paymentMethod     String?
  /// "unpaid" | "paid" | "refunded" | "failed"
  paymentStatus     String            @default("unpaid")
  /// What paid the order: Stripe PaymentIntent id or PayPal capture id (PayPal order id until capture)
  paymentRef        String?
  /// The card checkout's PaymentIntent, kept apart from paymentRef so switching to PayPal never loses it
  stripePaymentIntentId String?
  /// The payment provider's fee for this order (PayPal capture fee or Stripe balance-transaction fee); null until recorded
  paymentFee        Float?
  /// Amount refunded so far through the payment provider; null when nothing was refunded
  refundedAmount    Float?
  /// Paid with a Stripe test-mode (sandbox) payment: never sent to the supplier, left out of sales figures
  testPayment       Boolean           @default(false)
  /// When the customer's order confirmation email was claimed for sending; set once, so it never goes out twice
  confirmationEmailSentAt DateTime?
  /// Supplier (CJdropshipping) order id once fulfillment has been triggered
  fulfillmentRef    String?
  /// Supplier's own order status, e.g. CJ's CREATED, UNPAID, UNSHIPPED, SHIPPED
  supplierStatus    String?
  /// What CJ charges for the goods and for shipping this order; null until recorded
  supplierProductCost  Float?
  supplierShippingCost Float?
  /// Why automatic fulfillment needs attention (shown in admin); null when fine
  fulfillmentError  String?
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)
  trackingNumber    String?
  shippedAt         DateTime?
  /// When the order was first marked Delivered; cleared if that's undone
  deliveredAt       DateTime?
  /// When the post-delivery review request email was claimed for sending; set once
  reviewRequestSentAt DateTime?
  /// Which ad brought the customer (from the landing URL, kept 30 days in a cookie)
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  utmContent        String?
  utmTerm           String?
  fbclid            String?
  /// Meta Conversions API inputs captured at checkout: fbp, fbc, clientIp, userAgent, landing, eventSourceUrl, initiateCheckoutEventId
  attribution       Json?
  /// When the server-side Meta Purchase event was claimed for sending; one per order
  metaPurchaseSentAt DateTime?
  userId            String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  user              User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  sentEmails        SentEmail[]
  reviews           Review[]
  checkoutTokens    CheckoutToken[]

  @@index([status])
  @@index([createdAt])
  @@index([userId])
  @@index([paymentRef])
  @@index([stripePaymentIntentId])
  @@index([fulfillmentStatus])
  @@index([utmCampaign])
  @@map("orders")
}

/// A browser's (or a link's) right to pick up one started checkout. Only the
/// token's SHA-256 is stored; an order's personal details are never served to
/// someone who holds just its KTV reference.
model CheckoutToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  /// "session": held by the browser that is checking out (cookie and local storage), 48 hours from the last save.
  /// "link": carried in a URL (open-in-browser hand-off, PayPal return, recovery email); short-lived, exchanged for a session.
  kind      String
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([expiresAt])
  @@map("checkout_tokens")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  productName String
  productSlug String
  unitPrice   Float
  quantity    Int
  lineTotal   Float
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@map("order_items")
}

model SiteContent {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("site_content")
}

model NavigationItem {
  id        String   @id @default(cuid())
  label     String
  link      String
  position  Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
  @@map("navigation_items")
}

model ProductTranslation {
  id               String   @id @default(cuid())
  productId        String
  locale           String
  name             String
  shortDescription String
  description      String
  details          String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([productId, locale])
  @@index([productId])
  @@map("product_translations")
}

model CategoryTranslation {
  id         String   @id @default(cuid())
  categoryId String
  locale     String
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([categoryId, locale])
  @@index([categoryId])
  @@map("category_translations")
}

model EmailSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("newsletter")
  createdAt DateTime @default(now())

  @@map("email_subscribers")
}

/// Phones running the Kitvoy admin app that receive sale push notifications
model AdminDevice {
  id         String   @id @default(cuid())
  /// FCM registration token (Android) or APNs-backed FCM token (iOS)
  token      String   @unique
  /// "android" | "ios"
  platform   String   @default("android")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  /// Last time the app re-registered this token
  lastSeenAt DateTime @default(now())

  @@map("admin_devices")
}

/// Emails sent by hand from the admin dashboard (Messages page or an order)
model SentEmail {
  id          String   @id @default(cuid())
  /// Display form, e.g. "Kitvoy Support <support@kitvoy.com>"
  fromAddress String
  toAddress   String
  subject     String
  /// Plain-text message as typed; the HTML email is built from it
  body        String
  /// "sent" | "failed"
  status      String
  /// SMTP error when sending failed
  error       String?
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([createdAt])
  @@map("sent_emails")
}
